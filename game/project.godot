; Engine configuration file.
; Echoborn - spike echo-opname (issue #5). Zie docs/tech/ontwerp.md.

config_version=5

[application]

config/name="Echoborn"
config/description="Spike: echo-opname en -afspelen, 2 lokale spelers."
run/main_scene="res://levels/flowkamer/flowkamer.tscn"
config/features=PackedStringArray("4.6")

[autoload]

InputRouter="*res://scripts/input/input_router.gd"
Localization="*res://scripts/locale/localization.gd"
Progress="*res://scripts/save/progress.gd"
SaveService="*res://scripts/save/save_service.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/viewport_width.deck=1280
window/size/viewport_height.deck=800
window/size/mode.deck=3
window/vsync/vsync_mode.deck=1

[internationalization]

locale/fallback="en"

[layer_names]

2d_physics/layer_1="wereld"
2d_physics/layer_2="licht"
2d_physics/layer_3="schaduw"
2d_physics/layer_4="licht-geometrie"
2d_physics/layer_5="schaduw-geometrie"
2d_physics/layer_6="schaduwplank"
2d_physics/layer_7="zones"
2d_physics/layer_8="lichtplank"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_jitter_fix=0.0
2d/physics_engine="GodotPhysics2D"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
